# Copy this file to .env and fill in your values:   cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ============================================================
# THE TOGGLE:  local | cloud
#   local -> only GOOGLE_API_KEY is needed.
#   cloud -> Vertex AI Vector Search + Cloud Storage. Fill in the CLOUD block below.
# ============================================================
APP_MODE=local
ENVIRONMENT=local

# Gemini API key (https://aistudio.google.com/apikey) - needed in BOTH modes
GOOGLE_API_KEY=your-gemini-api-key

# Optional (these are the defaults)
VERTEX_LLM_MODEL_NAME=gemini-3.8-flash
LLM_TEMPERATURE=0.0
LOCAL_EMBEDDING_MODEL_NAME=gemini-embedding-001
# Chroma and uploaded PDFs are persisted here in local mode.
# LOCAL_DATA_DIR=./.meridian

# ============================================================
# CLOUD block - only read when APP_MODE=cloud
# ============================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Path to the service-account key used for Vertex AI + Cloud Storage when running cloud mode from a laptop
GCP_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# Cloud Storage bucket (created by the GitHub Action: <project-id>-vector-staging)
GCS_BUCKET_NAME=your-gcp-project-id-vector-staging
GCS_PREFIX=uploads/

# IDs printed at the end of the "Provision Vector Search" step in GitHub Actions
VECTOR_SEARCH_INDEX_ID=
VECTOR_SEARCH_INDEX_ENDPOINT_ID=

VERTEX_EMBEDDING_MODEL_NAME=text-embedding-005
